  const a = document.createElement('a');
  a.href = `#${s.id}`; a.className='node-btn'; a.dataset.id = s.id;
  a.innerHTML = `<span class="node-dot"></span><span class="node-label">${s.label}</span>`;
  nav.appendChild(a);
});
nav.appendChild(document.getElementById('playerMarker')); // reordenar al final para z-index

const nodeButtons = [...document.querySelectorAll('.node-btn')];
const sectionEls = secciones.map(s=>document.getElementById(s.id));

function updateActiveNode(){
  let current = sectionEls[0];
  const scrollPos = window.scrollY + window.innerHeight * 0.4;
  sectionEls.forEach(el=>{ if(el && el.offsetTop <= scrollPos) current = el; });
  nodeButtons.forEach(btn=>btn.classList.toggle('active', btn.dataset.id === current.id));

  // marcador jugador + progreso de línea (solo escritorio)
  if(window.innerWidth > 880){
    const idx = sectionEls.indexOf(current);
    const total = nodeButtons.length - 1;
    const btnRect = nodeButtons[idx]?.getBoundingClientRect();
    const navRect = nav.getBoundingClientRect();
    if(btnRect){
      const top = btnRect.top - navRect.top + btnRect.height/2 - 5;
      document.getElementById('playerMarker').style.top = top + 'px';
    }
    const pct = idx/total;
    const progressLine = document.getElementById('pathProgress');
    const navHeight = nav.getBoundingClientRect().height;
    progressLine.setAttribute('y2', (pct*navHeight) + 'px');
  }
}
window.addEventListener('scroll', updateActiveNode, { passive:true });
window.addEventListener('resize', updateActiveNode);
updateActiveNode();

// ================= ANIMACIONES AL HACER SCROLL =================
const seen = new Set();
const io = new IntersectionObserver((entries)=>{
  entries.forEach(entry=>{
    if(entry.isIntersecting){
      // animar barras de stats
      entry.target.querySelectorAll('.stat-fill').forEach(f=>{
        f.style.width = f.dataset.val + '%';
      });
      // logro desbloqueado (una vez por sección, no en el hero)
      if(entry.target.tagName === 'SECTION' && !seen.has(entry.target.id)){
        seen.add(entry.target.id);
        if(seen.size > 1){ // evita disparar en la primera sección vista al cargar
          showAchievement(entry.target.id);
        }
      }
    }
  });
}, { threshold: 0.3 });
document.querySelectorAll('.level').forEach(el=>io.observe(el));

